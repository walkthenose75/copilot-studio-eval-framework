# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Microsoft Entra -------------------------------------------------------
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000

# AUTH_MODE: client_secret | device_code | interactive | azure_cli
#   client_secret  unattended pipelines. NOTE: the Power Platform API grants
#                  DELEGATED permissions only - a service principal's effective
#                  access comes from the Power Platform RBAC role assigned to
#                  it, not from app permissions. See SETUP.md step 2.
#   device_code    best for first-run setup and machines with no browser
AUTH_MODE=device_code
# CLIENT_SECRET=                 # only for AUTH_MODE=client_secret

# --- Target agent ----------------------------------------------------------
# Both are in Copilot Studio under Settings > Advanced > Details
ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
BOT_ID=00000000-0000-0000-0000-000000000000

# --- Persona user profiles (optional) --------------------------------------
# Power Automate > Connections > Microsoft Copilot Studio, then copy the ID from
# .../connections/shared_microsoftcopilotstudio/{mcsConnectionId}/details
# Leave blank to run without authentication.
MCS_CONN_REPRESENTATIVE=
MCS_CONN_MANAGER=
MCS_CONN_EXECUTIVE=
MCS_CONN_COMPLIANCE=

# --- Dataverse results repository (optional) -------------------------------
# Unset DATAVERSE_URL to skip persistence entirely.
# DATAVERSE_URL=https://yourorg.crm.dynamics.com
DATAVERSE_PREFIX=cse

# --- Pipeline context (optional, recorded with each run) --------------------
ENVIRONMENT_TIER=UAT
SOLUTION_VERSION=
